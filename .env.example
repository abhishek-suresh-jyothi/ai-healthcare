# Local PostgreSQL connection; do not use these example credentials in production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional. When set, sign-in uses Firebase Authentication (Email/Password).
# Create Firebase users with verified emails that match active users in PostgreSQL.
NEXT_PUBLIC_FIREBASE_API_KEY=

# Required in production. Generate a unique random secret of at least 32 characters.
SESSION_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# Development seed only. The same password is assigned to all synthetic demo roles.
DEMO_PASSWORD=ArogyaDemo#2026

# Set to "true" to also create synthetic clinical records (patients, appointments,
# laboratory reports, bills, pharmacy stock batches, maternal records).
# When "false" only system, catalogue, and sign-in data is provisioned, so the
# clinical database stays empty.
DEMO_CLINICAL_DATA=false
